---
import { ContainerSection } from 'lucode-starlight/components';
import { aboutData } from '../../data/about';

const firstName = aboutData.name.split(' ')[0];
const hackathonIntro = aboutData.sectionIntro.hackathonsText.replace(
    '{count}',
    String(aboutData.hackathons.length)
);
const siteBase = import.meta.env.BASE_URL.replace(/\/$/, '');
const resolveLocalPath = (path: string) => `${siteBase}${path}`;
const resolveSiteHref = (href: string) =>
    href.startsWith('http://') ||
    href.startsWith('https://') ||
    href.startsWith('mailto:') ||
    href.startsWith('#')
        ? href
        : `${siteBase}${href}`;

const indexedPhotos = aboutData.photos.map((photo, index) => ({
    ...photo,
    index,
    resolvedSrc: resolveLocalPath(photo.src),
}));

const photoColumns = [
    indexedPhotos.filter((_, index) => index % 3 === 0),
    indexedPhotos.filter((_, index) => index % 3 === 1),
    indexedPhotos.filter((_, index) => index % 3 === 2),
];

const photoAspects = [
    ['square', 'square', 'square'],
    ['portrait', 'landscape', 'portrait'],
    ['square', 'square', 'square'],
];

const timelineAccents = [
    'linear-gradient(135deg, #84cc16 0%, #22c55e 100%)',
    'linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%)',
    'linear-gradient(135deg, #f59e0b 0%, #f97316 100%)',
    'linear-gradient(135deg, #a855f7 0%, #ec4899 100%)',
    'linear-gradient(135deg, #0ea5e9 0%, #22c55e 100%)',
    'linear-gradient(135deg, #f97316 0%, #eab308 100%)',
];

const defaultSkillIcon =
    '<svg viewBox="0 0 24 24" aria-hidden="true" fill="none"><circle cx="12" cy="12" r="6" fill="currentColor" opacity="0.18"></circle><circle cx="12" cy="12" r="3" fill="currentColor"></circle></svg>';

const skillIcons: Record<string, string> = {
    Astro: '<svg viewBox="0 0 24 24" aria-hidden="true" fill="none"><path d="M8.4 18.4c.7-.6 1.8-.9 2.9-.8 1.2 0 2.4.3 3.1.8-.3-.7-.4-1.5-.2-2.3.3-1.3 1.1-2.2 2.3-2.8-1.1.3-2.2.1-3.2-.5L12 11.9l-1.3.9c-1 .6-2.1.8-3.2.5 1.2.6 2 1.5 2.3 2.8.2.8.1 1.6-.2 2.3Z" fill="#111827"></path><path d="M11.2 3h1.6l4.6 13.2-2.8-2-2.6-1.8-2.6 1.8-2.8 2L11.2 3Z" fill="url(#astro-gradient)"></path><defs><linearGradient id="astro-gradient" x1="7" y1="5" x2="18" y2="18" gradientUnits="userSpaceOnUse"><stop stop-color="#A855F7"></stop><stop offset="1" stop-color="#F97316"></stop></linearGradient></defs></svg>',
    React: '<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="#149ECA" stroke-width="1.7"><ellipse cx="12" cy="12" rx="9" ry="3.7"></ellipse><ellipse cx="12" cy="12" rx="9" ry="3.7" transform="rotate(60 12 12)"></ellipse><ellipse cx="12" cy="12" rx="9" ry="3.7" transform="rotate(120 12 12)"></ellipse><circle cx="12" cy="12" r="1.8" fill="#149ECA" stroke="none"></circle></svg>',
    'Next.js': '<svg viewBox="0 0 24 24" aria-hidden="true" fill="none"><circle cx="12" cy="12" r="11" fill="#111111"></circle><path d="M9 16V8h1.3l4.7 6V8H16v8h-1.2l-4.8-6v6H9Z" fill="#ffffff"></path></svg>',
    TypeScript: '<svg viewBox="0 0 24 24" aria-hidden="true" fill="none"><rect x="2.5" y="2.5" width="19" height="19" rx="4" fill="#3178C6"></rect><path d="M7.4 8.4h8.9v2h-3.3V18H10.7v-7.6H7.4v-2Zm9.4.1c1.7 0 2.8.8 3.4 1.5l-1.5 1.5c-.5-.5-1.1-.9-2-.9-.8 0-1.3.3-1.3.9 0 .5.4.8 1.8 1.1 1.9.4 3.3 1 3.3 3 0 2-1.6 3-3.8 3-1.7 0-3.1-.6-4-1.6l1.4-1.6c.8.7 1.6 1.2 2.7 1.2.9 0 1.4-.3 1.4-.9 0-.5-.4-.8-1.7-1.1-2-.5-3.4-1-3.4-3 0-1.7 1.4-2.9 3.7-2.9Z" fill="#ffffff"></path></svg>',
    'Node.js': '<svg viewBox="0 0 24 24" aria-hidden="true" fill="none"><path d="m12 2.5 8 4.6v9.8l-8 4.6-8-4.6V7.1l8-4.6Z" fill="#5FA04E"></path><path d="M12.1 6.7c1.8 0 2.9.9 3.5 2l-1.4.9c-.4-.6-1-.9-1.9-.9-1.3 0-2.2 1-2.2 2.6 0 1.6.9 2.6 2.2 2.6.9 0 1.5-.4 2-.9l1.3.9c-.7 1.1-1.8 2-3.5 2-2.4 0-4.2-1.7-4.2-4.6s1.8-4.6 4.2-4.6Z" fill="#ffffff"></path></svg>',
    Python: '<svg viewBox="0 0 24 24" aria-hidden="true" fill="none"><path d="M12 4c2.8 0 4.5 1.2 4.5 3.6v2.1H10c-1.6 0-2.8 1.1-2.8 2.6v1.2H5.5A2.5 2.5 0 0 1 3 11V9.8C3 6.5 5.6 4 9.2 4H12Z" fill="#3776AB"></path><circle cx="13.8" cy="6.8" r="0.9" fill="#ffffff"></circle><path d="M12 20c-2.8 0-4.5-1.2-4.5-3.6v-2.1H14c1.6 0 2.8-1.1 2.8-2.6v-1.2h1.7A2.5 2.5 0 0 1 21 13v1.2c0 3.3-2.6 5.8-6.2 5.8H12Z" fill="#4B8B3B"></path><circle cx="10.2" cy="17.2" r="0.9" fill="#ffffff"></circle></svg>',
    Go: '<svg viewBox="0 0 24 24" aria-hidden="true" fill="none"><path d="M3 10h3M2 12h4M3 14h3" stroke="#111111" stroke-width="1.8" stroke-linecap="round"></path><path d="M10.6 15.9c-2.1 0-3.6-1.5-3.6-3.9 0-2.3 1.5-3.9 3.6-3.9 1.1 0 2 .3 2.7.9l-.9 1.5c-.4-.3-1-.5-1.6-.5-1.1 0-1.8.8-1.8 2 0 1.3.7 2.1 1.8 2.1.7 0 1.1-.2 1.5-.5v-1h-1.5V11h3.3v3.7c-.8.8-2 1.2-3.2 1.2Zm8.2 0c-2 0-3.5-1.6-3.5-3.9s1.5-3.9 3.5-3.9 3.5 1.6 3.5 3.9-1.5 3.9-3.5 3.9Zm0-1.8c.9 0 1.7-.8 1.7-2.1 0-1.2-.8-2-1.7-2s-1.7.8-1.7 2c0 1.3.8 2.1 1.7 2.1Z" fill="#111111"></path></svg>',
    Postgres: '<svg viewBox="0 0 24 24" aria-hidden="true" fill="none"><path d="M8.1 7.2C8.9 5.2 10.4 4 12.2 4c2.8 0 4.7 2.5 4.7 6.2v5c0 1.6-.7 2.8-1.9 3.6-.7.5-1.7.8-2.8.8-.7 0-1.2-.1-1.8-.3l.6-1.8c.3.1.6.2 1.1.2.9 0 1.6-.3 2.1-.9.4-.5.6-1.1.6-1.9v-.2c-.7.6-1.6.9-2.8.9-2.6 0-4.4-1.8-4.4-4.5 0-1.7.2-3 .5-3.9Z" fill="#336791"></path><path d="M10 10.7c0-1.8.9-3 2.3-3 1.5 0 2.5 1.3 2.5 3.3 0 1.9-.9 3.1-2.4 3.1-1.5 0-2.4-1.2-2.4-3.4Z" fill="#ffffff" opacity=".92"></path><circle cx="11.6" cy="10" r=".55" fill="#336791"></circle><circle cx="13.7" cy="10" r=".55" fill="#336791"></circle></svg>',
    Docker: '<svg viewBox="0 0 24 24" aria-hidden="true" fill="none"><rect x="4" y="10" width="3" height="3" rx=".5" fill="#2496ED"></rect><rect x="7.5" y="10" width="3" height="3" rx=".5" fill="#2496ED"></rect><rect x="11" y="10" width="3" height="3" rx=".5" fill="#2496ED"></rect><rect x="7.5" y="6.5" width="3" height="3" rx=".5" fill="#2496ED"></rect><rect x="11" y="6.5" width="3" height="3" rx=".5" fill="#2496ED"></rect><path d="M5 14.6c.5 2.1 2.3 3.4 4.8 3.4 4.1 0 7-1.8 8.2-4.8.8.1 1.9-.1 3-.9-.4-1-1.1-1.7-2.1-2 .1-.7 0-1.4-.2-1.9-.8.4-1.3 1-1.5 1.8H5Z" fill="#2496ED"></path></svg>',
    Kubernetes: '<svg viewBox="0 0 24 24" aria-hidden="true" fill="none"><path d="m12 3.4 6.8 3.9v7.8L12 19l-6.8-3.9V7.3L12 3.4Z" fill="#326CE5"></path><circle cx="12" cy="11.2" r="2.1" fill="#ffffff"></circle><path d="M12 6.2v2.3M12 13.9v2.3M7.8 8.6l1.9 1.1M14.3 13.5l1.9 1.1M16.2 8.6l-1.9 1.1M9.7 13.5l-1.9 1.1" stroke="#ffffff" stroke-width="1.5" stroke-linecap="round"></path></svg>',
};

const photoLightboxScript = `
(() => {
  const root = document.querySelector('[data-photo-lightbox-root]');
  if (!root) return;

  const dialog = root.querySelector('[data-photo-lightbox]');
  const scroller = root.querySelector('[data-photo-lightbox-scroller]');
  const prevButton = root.querySelector('[data-photo-lightbox-prev]');
  const nextButton = root.querySelector('[data-photo-lightbox-next]');
  const counter = root.querySelector('[data-photo-lightbox-count]');
  const closeButtons = root.querySelectorAll('[data-photo-lightbox-close]');
  const triggers = root.querySelectorAll('[data-photo-index]');
  const items = root.querySelectorAll('[data-photo-lightbox-item]');
  if (!dialog || !scroller || !triggers.length || !items.length || !prevButton || !nextButton || !counter) return;

  let lastTrigger = null;
  let currentIndex = 0;

  const lockScroll = () => {
    document.documentElement.style.overflow = 'hidden';
    document.body.style.overflow = 'hidden';
  };

  const unlockScroll = () => {
    document.documentElement.style.overflow = '';
    document.body.style.overflow = '';
  };

  const updateControls = () => {
    counter.textContent = \`\${currentIndex + 1} / \${items.length}\`;
    prevButton.disabled = currentIndex === 0;
    nextButton.disabled = currentIndex === items.length - 1;
  };

  const goToIndex = (index, behavior = 'smooth') => {
    currentIndex = Math.max(0, Math.min(index, items.length - 1));
    const target = items[currentIndex];
    target?.scrollIntoView({ block: 'nearest', inline: 'center', behavior });
    updateControls();
  };

  const openLightbox = (index, trigger) => {
    lastTrigger = trigger ?? null;
    dialog.hidden = false;
    dialog.dataset.open = 'true';
    lockScroll();
    requestAnimationFrame(() => {
      goToIndex(Number(index), 'instant');
    });
  };

  const closeLightbox = () => {
    dialog.hidden = true;
    dialog.dataset.open = 'false';
    unlockScroll();
    if (lastTrigger instanceof HTMLElement) lastTrigger.focus();
  };

  triggers.forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const index = trigger.getAttribute('data-photo-index');
      if (index !== null) openLightbox(index, trigger);
    });
  });

  closeButtons.forEach((button) => {
    button.addEventListener('click', closeLightbox);
  });

  prevButton.addEventListener('click', () => {
    goToIndex(currentIndex - 1);
  });

  nextButton.addEventListener('click', () => {
    goToIndex(currentIndex + 1);
  });

  dialog.addEventListener('click', (event) => {
    if (event.target === dialog) closeLightbox();
  });

  document.addEventListener('keydown', (event) => {
    if (dialog.hidden) return;
    if (event.key === 'Escape') {
      event.preventDefault();
      closeLightbox();
    }
    if (event.key === 'ArrowRight') {
      event.preventDefault();
      goToIndex(currentIndex + 1);
    }
    if (event.key === 'ArrowLeft') {
      event.preventDefault();
      goToIndex(currentIndex - 1);
    }
  });

  updateControls();
})();
`;
---

<ContainerSection width="md">
    <main class="about-page-shell">
        <section class="hero-block">
            <div class="hero-copy">
                <div class="hero-identity">
                    <h1>{`Hi, I'm ${firstName}`}</h1>
                    <p class="hero-description hero-lede narrative-copy">{aboutData.description}</p>
                </div>
            </div>

            <div class="hero-avatar-wrap">
                <img
                    class="hero-avatar"
                    src={resolveLocalPath(aboutData.avatarUrl)}
                    alt={aboutData.name}
                    loading="eager"
                />
            </div>
        </section>

        <section id="about" class="section-rail">
            <div class="section-heading">
                <h2 class="section-title-display">About</h2>
            </div>
            <div class="prose-copy narrative-copy" set:html={aboutData.summaryHtml} />
        </section>

        <section id="work" class="section-rail">
            <div class="section-heading">
                <h2 class="section-title-display">Work Experience</h2>
            </div>

            <div class="work-accordion work-accordion-framed">
                {
                    aboutData.work.map((item, index) => (
                        <details class="work-item" open={index === 0}>
                            <summary>
                                <div class="entity-main">
                                    <img src={item.logoUrl} alt="" loading="lazy" />
                                    <div class="entity-copy">
                                        <span class="entity-title">{item.company}</span>
                                        <span class="entity-subtitle">{item.title}</span>
                                    </div>
                                </div>
                                <span class="entity-meta">{item.start} - {item.end}</span>
                            </summary>
                            <div class="work-body">
                                <p class="narrative-copy">{item.description}</p>
                            </div>
                        </details>
                    ))
                }
            </div>
        </section>

        <section id="education" class="section-rail">
            <div class="section-heading">
                <h2 class="section-title-display">Education</h2>
            </div>

            <div class="entity-list">
                {
                    aboutData.education.map((item) => (
                        <a class="entity-row" href={item.href} target="_blank" rel="noreferrer">
                            <div class="entity-main">
                                <img src={item.logoUrl} alt="" loading="lazy" />
                                <div class="entity-copy">
                                    <span class="entity-title">{item.school}</span>
                                    <span class="entity-subtitle">{item.degree}</span>
                                </div>
                            </div>
                            <span class="entity-meta">{item.start} - {item.end}</span>
                        </a>
                    ))
                }
            </div>
        </section>

        <section id="skills" class="section-rail">
            <div class="section-heading">
                <h2 class="section-title-display">Skills</h2>
            </div>

            <div class="skill-cloud">
                {
                    aboutData.skills.map((skill) => (
                        <span class="skill-chip">
                            <span class="skill-icon" set:html={skillIcons[skill] ?? defaultSkillIcon} />
                            <span class="skill-label">{skill}</span>
                        </span>
                    ))
                }
            </div>
        </section>

        <section id="projects" class="section-rail section-rail-wide">
            <div class="section-promo">
                <div class="section-divider">
                    <span class="section-divider-pill">{aboutData.sectionIntro.projectsLabel}</span>
                </div>
                <h2 class="section-title-display">{aboutData.sectionIntro.projectsHeading}</h2>
                <p class="narrative-copy">{aboutData.sectionIntro.projectsText}</p>
            </div>

            <div class="project-grid project-grid-aligned">
                {
                    aboutData.projects.map((project) => (
                        <article class="project-card-shell">
                            <div class="project-media">
                                <a class="project-media-link" href={project.href} target="_blank" rel="noreferrer">
                                    {project.video ? (
                                        <video
                                            class="project-video"
                                            src={project.video}
                                            poster={resolveLocalPath(project.poster)}
                                            autoplay
                                            loop
                                            muted
                                            playsinline
                                        />
                                    ) : project.image ? (
                                        <img
                                            src={resolveLocalPath(project.image)}
                                            alt={project.title}
                                            loading="lazy"
                                        />
                                    ) : (
                                        <div class="project-placeholder" aria-hidden="true" />
                                    )}
                                </a>

                                {
                                    project.links.length > 0 && (
                                        <div class="project-links-overlay">
                                            {
                                                project.links.map((link) => (
                                                    <a href={link.href} target="_blank" rel="noreferrer">
                                                        {link.label}
                                                    </a>
                                                ))
                                            }
                                        </div>
                                    )
                                }
                            </div>

                            <div class="project-copy">
                                <div class="project-head">
                                    <div>
                                        <h3>{project.title}</h3>
                                        <p class="project-dates">{project.dates}</p>
                                    </div>
                                    <a href={project.href} target="_blank" rel="noreferrer">
                                        Open
                                    </a>
                                </div>

                                <p class="project-description narrative-copy">{project.description}</p>

                                <div class="tag-row">
                                    {
                                        project.technologies.map((tech) => (
                                            <span class="tag">{tech}</span>
                                        ))
                                    }
                                </div>
                            </div>
                        </article>
                    ))
                }
            </div>
        </section>

        <section id="photos" class="section-rail section-rail-wide">
            <div class="section-promo section-promo-tight">
                <div class="section-divider">
                    <span class="section-divider-pill">Photos</span>
                </div>
                <h2 class="section-title-display">{aboutData.sectionIntro.photosHeading}</h2>
            </div>

            <div class="photo-columns" data-photo-lightbox-root>
                {
                    photoColumns.map((column, columnIndex) => (
                        <div class="photo-column">
                            {
                                column.map((photo, photoIndex) => (
                                    <div class="photo-frame">
                                        <button
                                            type="button"
                                            class="photo-trigger"
                                            data-photo-index={String(photo.index)}
                                            aria-label={`Open ${photo.alt}`}
                                        >
                                            <img
                                                src={photo.resolvedSrc}
                                                alt={photo.alt}
                                                loading="eager"
                                                decoding="async"
                                                class={`photo-tile ${photoAspects[columnIndex][photoIndex] ?? 'square'}`}
                                            />
                                        </button>
                                    </div>
                                ))
                            }
                        </div>
                    ))
                }

                <div class="photo-lightbox" data-photo-lightbox hidden data-open="false" aria-hidden="true">
                    <div class="photo-lightbox-nav">
                        <button
                            type="button"
                            class="photo-lightbox-arrow"
                            data-photo-lightbox-prev
                            aria-label="Previous photo"
                        >
                            <span aria-hidden="true">‹</span>
                        </button>
                        <span class="photo-lightbox-count" data-photo-lightbox-count>1 / 9</span>
                        <button
                            type="button"
                            class="photo-lightbox-arrow"
                            data-photo-lightbox-next
                            aria-label="Next photo"
                        >
                            <span aria-hidden="true">›</span>
                        </button>
                    </div>

                    <button
                        type="button"
                        class="photo-lightbox-close"
                        data-photo-lightbox-close
                        aria-label="Close photo viewer"
                    >
                        Close
                    </button>

                    <div class="photo-lightbox-scroller" data-photo-lightbox-scroller>
                        {
                            indexedPhotos.map((photo) => (
                                <figure class="photo-lightbox-item" data-photo-lightbox-item={String(photo.index)}>
                                    <img src={photo.resolvedSrc} alt={photo.alt} loading="eager" decoding="async" />
                                </figure>
                            ))
                        }
                    </div>
                </div>
            </div>
        </section>

        <section id="hackathons" class="section-rail section-rail-wide">
            <div class="section-promo">
                <div class="section-divider">
                    <span class="section-divider-pill">{aboutData.sectionIntro.hackathonsLabel}</span>
                </div>
                <h2 class="section-title-display">{aboutData.sectionIntro.hackathonsHeading}</h2>
                <p class="narrative-copy">{hackathonIntro}</p>
            </div>

            <div class="timeline-list timeline-track timeline-axis-centered">
                {
                    aboutData.hackathons.map((item, index) => (
                        <article class="timeline-row">
                            <div class="timeline-node" style={`--timeline-accent: ${timelineAccents[index % timelineAccents.length]};`}>
                                <img src={item.image} alt="" loading="lazy" />
                            </div>
                            <div class="timeline-copy">
                                <span class="timeline-date">{item.dates}</span>
                                <h3>{item.title}</h3>
                                <p class="timeline-location">{item.location}</p>
                                <p class="narrative-copy">{item.description}</p>
                                <div class="timeline-links">
                                    {item.badge && <span class="award-badge">{item.badge}</span>}
                                    {
                                        item.links.map((link) => (
                                            <a href={link.href} target="_blank" rel="noreferrer">
                                                {link.label}
                                            </a>
                                        ))
                                    }
                                </div>
                            </div>
                        </article>
                    ))
                }
            </div>
        </section>

        <section id="contact" class="section-rail">
            <div class="contact-panel">
                <div class="contact-grid-pattern" aria-hidden="true">
                    <div class="contact-flicker-layer contact-flicker-base" />
                    <div class="contact-flicker-layer contact-flicker-glow" />
                </div>
                <span class="contact-pill">{aboutData.sectionIntro.contactLabel}</span>
                <h2 class="contact-title">{aboutData.sectionIntro.contactHeading}</h2>
                <p class="contact-copy">{aboutData.sectionIntro.contactText}</p>
            </div>
        </section>
    </main>
</ContainerSection>

<script is:inline set:html={photoLightboxScript}></script>

<style>
    .about-page-shell {
        width: 100%;
        max-width: 42rem;
        margin-inline: auto;
        display: grid;
        gap: calc(var(--spacing) * 16);
        padding-block: calc(var(--spacing) * 10) calc(var(--spacing) * 18);
    }

    .hero-block,
    .section-rail {
        display: grid;
        gap: calc(var(--spacing) * 4.5);
    }

    .section-rail-wide {
        max-width: 50rem;
        width: min(100%, 50rem);
        margin-inline: calc((42rem - min(100%, 50rem)) / 2);

        @media (max-width: 52rem) {
            width: 100%;
            margin-inline: 0;
        }
    }

    .hero-block {
        align-items: center;
        gap: calc(var(--spacing) * 6);

        @media (min-width: 768px) {
            grid-template-columns: minmax(0, 1fr) auto;
        }
    }

    .hero-copy {
        display: grid;
        gap: calc(var(--spacing) * 2.5);
    }

    .hero-identity {
        display: grid;
        gap: calc(var(--spacing) * 2.5);
    }

    .hero-copy h1 {
        font-size: clamp(2.75rem, 5.4vw, 4.1rem);
        font-weight: 600;
        line-height: 0.94;
        letter-spacing: -0.04em;
        text-wrap: balance;
        max-width: 12ch;
    }

    .hero-description,
    .entity-subtitle {
        color: var(--muted-foreground);
    }

    .hero-lede {
        max-width: 38rem;
        font-size: 1rem;
        line-height: 1.75;
