---
import { Image } from 'astro:assets';
import portrait from '../../assets/scholar-portrait.png';

const SITE_DATA = {
    name: 'Dr. Beatrix Bumble',
    tagline: 'Avian-Feline Fluff Dynamics | Lead Investigator',
    twitter: '[your-twitter-handle]',
    linkedin: '[your-linkedin-template]',
    scholar: '[your-scholar-id]',
    email: '[your-email-address]',
};
---

<section class="scholar-hero">
    <div class="scholar-hero-content">
        <div class="scholar-portrait-container">
            <Image src={portrait} alt={SITE_DATA.name} class="portrait" />
        </div>

        <div class="scholar-hero-text">
            <h1>{SITE_DATA.name}</h1>
            <p class="scholar-tagline">{SITE_DATA.tagline}</p>

            <div class="scholar-socials" aria-label="Social links">
                <a href={`https://twitter.com/${SITE_DATA.twitter}`} aria-label="Twitter" target="_blank" rel="noreferrer">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z" />
                    </svg>
                </a>
                <a href={`https://linkedin.com/in/${SITE_DATA.linkedin}`} aria-label="LinkedIn" target="_blank" rel="noreferrer">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M20.5 2h-17A1.5 1.5 0 002 3.5v17A1.5 1.5 0 003.5 22h17a1.5 1.5 0 001.5-1.5v-17A1.5 1.5 0 0020.5 2zM8 19H5v-9h3zM6.5 8.25a1.75 1.75 0 110-3.5 1.75 1.75 0 010 3.5zM19 19h-3v-4.74c0-1.42-.6-1.93-1.38-1.93A1.74 1.74 0 0013 14.19V19h-3v-9h2.9v1.3a3.11 3.11 0 012.7-1.4c1.55 0 3.4 1.08 3.4 3.93z" />
                    </svg>
                </a>
                <a
                    href={`https://scholar.google.com/citations?user=${SITE_DATA.scholar}`}
                    aria-label="Google Scholar"
                    target="_blank"
                    rel="noreferrer"
                >
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 2L1 7l11 5 9-4.09V17h2V7L12 2z" />
                        <path d="M19 11v6c0 1.66-3.13 3-7 3s-7-1.34-7-3v-6l7 3 7-3z" />
                    </svg>
                </a>
                <a href={`mailto:${SITE_DATA.email}`} aria-label="Email">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z" />
                    </svg>
                </a>
            </div>
        </div>
    </div>
</section>

<style>
    .scholar-hero {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: calc(100dvh - 16rem);
        padding: 4rem 0 6rem;
    }

    .scholar-hero-content {
        display: flex;
        flex-flow: row wrap;
        align-items: center;
        justify-content: center;
        gap: 3rem;
        width: 100%;
        max-width: 68rem;
        margin: 0 auto;
    }

    .scholar-portrait-container {
        flex: 0 1 auto;
        display: flex;
        justify-content: center;
    }

    .portrait {
        width: min(28rem, 42vw);
        height: min(28rem, 42vw);
        border-radius: 50%;
        object-fit: cover;
        box-shadow: 0 0 20px 10px color-mix(in oklab, var(--foreground) 14%, transparent);
    }

    .scholar-hero-text {
        flex: 0 1 auto;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .scholar-hero-text h1 {
        font-size: 3rem;
        margin: 0;
        color: var(--foreground);
        font-weight: 700;
        line-height: 1;
        letter-spacing: -0.04em;
    }

    .scholar-tagline {
        font-size: 1.25rem;
        color: var(--muted-foreground);
        margin: 1.2rem 0 2.4rem;
        font-weight: 300;
    }

    .scholar-socials {
        display: flex;
        flex-wrap: wrap;
        gap: 1.5rem;
    }

    .scholar-socials a {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: var(--foreground);
        transition: color 0.2s ease, transform 0.2s ease;
    }

    .scholar-socials a:hover {
        color: var(--accent);
        transform: translateY(-1px);
    }

    .scholar-socials svg {
        width: 2.5rem;
        height: 2.5rem;
        fill: currentColor;
    }

    /* Mobile: tablet (up to 960px) */
    @media (max-width: 960px) {
        .scholar-hero-content {
            flex-direction: column;
            gap: 1.5rem;
        }

        .scholar-hero-text {
            text-align: center;
            align-items: center;
            width: 100%;
            padding: 0 1.5rem;
        }

        .scholar-hero-text h1 {
            font-size: clamp(2rem, 8vw, 3rem);
        }

        .scholar-tagline {
            font-size: 1.1rem;
            margin-bottom: 2rem;
            white-space: normal;
            text-wrap: balance;
        }

        .portrait {
            width: min(240px, 38vw);
            height: min(240px, 38vw);
        }

        .scholar-hero {
            min-height: calc(100dvh - 14rem);
            padding: 3rem 0 5rem;
        }
    }

    /* Mobile: small tablet (up to 768px) */
    @media (max-width: 768px) {
        .portrait {
            width: min(200px, 45vw);
            height: min(200px, 45vw);
        }

        .scholar-hero {
            min-height: calc(100dvh - 13rem);
            padding: 2.5rem 0 4rem;
        }

        .scholar-socials svg {
            width: 2.25rem;
            height: 2.25rem;
        }

        .scholar-socials {
            gap: 1.25rem;
        }
    }

    /* Mobile: phone (up to 480px) */
    @media (max-width: 480px) {
        .scholar-hero-content {
            gap: 1.25rem;
        }

        .scholar-hero-text {
            padding: 0 1.25rem;
        }

        .portrait {
            width: min(160px, 55vw);
            height: min(160px, 55vw);
        }

        .scholar-hero {
            min-height: calc(100dvh - 12rem);
            padding: 2rem 0 3rem;
        }

        .scholar-hero-text h1 {
            font-size: clamp(1.6rem, 8vw, 2.2rem);
        }

        .scholar-tagline {
            font-size: 0.95rem;
            margin-bottom: 1.5rem;
            max-width: 20rem;
        }

        .scholar-socials svg {
            width: 2rem;
            height: 2rem;
        }

        .scholar-socials {
            gap: 1rem;
        }
    }
</style>
