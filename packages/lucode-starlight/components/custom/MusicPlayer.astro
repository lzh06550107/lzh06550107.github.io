---
import userConfig from 'virtual:lucode-starlight-config';

const tracks = userConfig.music?.tracks ?? [];
const autoplay = userConfig.music?.autoplay ?? false;
const hasTracks = tracks.length > 0;
---

{
    hasTracks && (
        <div
            id='music-player-root'
            class='music-player music-player--collapsed'
            data-tracks={JSON.stringify(tracks)}
            data-autoplay={String(autoplay)}
            transition:persist='music-player'
        >
            {/* Collapsed toggle button */}
            <button
                id='music-player-toggle'
                class='music-player__toggle'
                aria-label='Toggle music player'
                type='button'
            >
                <svg width='20' height='20' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>
                    <path d='M9 18V5l12-2v13' />
                    <circle cx='6' cy='18' r='3' />
                    <circle cx='18' cy='16' r='3' />
                </svg>
            </button>

            {/* Expanded player bar */}
            <div class='music-player__bar'>
                <div class='music-player__main'>
                    <button id='music-player-prev' class='music-player__btn' aria-label='Previous track' type='button'>
                        <svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'>
                            <polygon points='19 20 9 12 19 4 19 20' />
                            <line x1='5' y1='19' x2='5' y2='5' />
                        </svg>
                    </button>

                    <button id='music-player-play' class='music-player__btn music-player__btn--play' aria-label='Play' type='button'>
                        <svg width='18' height='18' viewBox='0 0 24 24' fill='currentColor' class='icon-play'>
                            <polygon points='5 3 19 12 5 21 5 3' />
                        </svg>
                        <svg width='18' height='18' viewBox='0 0 24 24' fill='currentColor' class='icon-pause' style='display:none'>
                            <rect x='6' y='4' width='4' height='16' />
                            <rect x='14' y='4' width='4' height='16' />
                        </svg>
                    </button>

                    <button id='music-player-next' class='music-player__btn' aria-label='Next track' type='button'>
                        <svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'>
                            <polygon points='5 4 15 12 5 20 5 4' />
                            <line x1='19' y1='5' x2='19' y2='19' />
                        </svg>
                    </button>

                    <div class='music-player__info'>
                        <span id='music-player-title' class='music-player__title'>-</span>
                        <div class='music-player__progress'>
                            <span id='music-player-current' class='music-player__time'>0:00</span>
                            <input id='music-player-seek' type='range' min='0' max='100' value='0' aria-label='Seek' />
                            <span id='music-player-duration' class='music-player__time'>0:00</span>
                        </div>
                    </div>
                </div>

                <div class='music-player__extra'>
                    <button id='music-player-volume-btn' class='music-player__btn' aria-label='Toggle mute' type='button'>
                        <svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' class='icon-volume'>
                            <polygon points='11 5 6 9 2 9 2 15 6 15 11 19 11 5' />
                            <path d='M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07' class='volume-high' />
                        </svg>
                        <svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' class='icon-mute' style='display:none'>
                            <polygon points='11 5 6 9 2 9 2 15 6 15 11 19 11 5' />
                            <line x1='23' y1='9' x2='17' y2='15' />
                            <line x1='17' y1='9' x2='23' y2='15' />
                        </svg>
                    </button>
                    <input id='music-player-volume' type='range' min='0' max='100' value='70' aria-label='Volume' class='music-player__volume-slider' />
                </div>
            </div>

            <audio id='music-player-audio' preload='auto'></audio>
        </div>
    )
}

<style>
    .music-player {
        position: fixed;
        bottom: 1rem;
        right: 1rem;
        z-index: 100;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 0.5rem;
        font-family: inherit;
    }

    .music-player__toggle {
        width: 2.75rem;
        height: 2.75rem;
        border-radius: 999px;
        border: 1px solid color-mix(in oklab, var(--foreground) 15%, transparent);
        background: color-mix(in oklab, var(--background) 92%, transparent);
        backdrop-filter: blur(8px);
        color: var(--foreground);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.12);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .music-player__toggle:hover {
        transform: scale(1.06);
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.12);
    }

    .music-player__bar {
        display: none;
        align-items: center;
        gap: 1rem;
        padding: 0.5rem 1rem;
        border-radius: 999px;
        border: 1px solid color-mix(in oklab, var(--foreground) 12%, transparent);
        background: color-mix(in oklab, var(--background) 92%, transparent);
        backdrop-filter: blur(12px);
        box-shadow: 0 2px 16px rgba(0, 0, 0, 0.12);
    }

    .music-player--expanded .music-player__bar {
        display: flex;
    }

    .music-player--expanded .music-player__toggle {
        display: none;
    }

    .music-player__main {
        display: flex;
        align-items: center;
        gap: 0.25rem;
    }

    .music-player__btn {
        width: 2rem;
        height: 2rem;
        border: none;
        background: transparent;
        color: var(--foreground);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        transition: background 0.15s ease;
    }

    .music-player__btn:hover {
        background: color-mix(in oklab, var(--foreground) 8%, transparent);
    }

    .music-player__btn--play {
        width: 2.25rem;
        height: 2.25rem;
    }

    .music-player__info {
        display: flex;
        flex-direction: column;
        gap: 0;
        min-width: 0;
        margin-left: 0.25rem;
    }

    .music-player__title {
        font-size: 0.8125rem;
        font-weight: 500;
        line-height: 1.2;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 14rem;
    }

    .music-player__progress {
        display: flex;
        align-items: center;
        gap: 0.35rem;
    }

    .music-player__time {
        font-size: 0.6875rem;
        color: var(--muted-foreground);
        font-variant-numeric: tabular-nums;
        min-width: 2rem;
        flex: none;
    }

    .music-player__progress input[type='range'],
    .music-player__volume-slider {
        -webkit-appearance: none;
        appearance: none;
        height: 4px;
        background: color-mix(in oklab, var(--foreground) 18%, transparent);
        border-radius: 999px;
        outline: none;
        cursor: pointer;
    }

    .music-player__progress input[type='range'] {
        width: 6rem;
    }

    .music-player__volume-slider {
        width: 3.5rem;
    }

    .music-player__progress input[type='range']::-webkit-slider-thumb,
    .music-player__volume-slider::-webkit-slider-thumb {
        -webkit-appearance: none;
        appearance: none;
        width: 10px;
        height: 10px;
        border-radius: 999px;
        background: var(--foreground);
        cursor: pointer;
    }

    .music-player__extra {
        display: flex;
        align-items: center;
        gap: 0.25rem;
    }

    @media (max-width: 640px) {
        .music-player {
            bottom: 0.5rem;
            right: 0.5rem;
        }

        .music-player__toggle {
            width: 3.5rem;
            height: 3.5rem;
        }

        .music-player__toggle svg {
            width: 24px;
            height: 24px;
        }

        .music-player__bar {
            padding: 0.5rem 0.85rem;
            gap: 0.75rem;
        }

        .music-player__title {
            max-width: 5rem;
            font-size: 0.75rem;
        }

        .music-player__main {
            gap: 0.2rem;
        }

        .music-player__btn {
            width: 2.75rem;
            height: 2.75rem;
        }

        .music-player__btn svg {
            width: 18px;
            height: 18px;
        }

        .music-player__btn--play {
            width: 3rem;
            height: 3rem;
        }

        .music-player__btn--play svg {
            width: 22px;
            height: 22px;
        }

        .music-player__progress input[type='range'] {
            width: 2.5rem;
        }

        .music-player__volume-slider {
            display: none;
        }

        .music-player__extra .music-player__btn {
            width: 2.5rem;
            height: 2.5rem;
        }

        .music-player__time {
            font-size: 0.625rem;
            min-width: 1.5rem;
        }
    }
</style>

<script>
    (function () {
        // Persisted across Astro view transitions: if already initialized in this
        // session, skip event binding and audio source setup. The audio element
        // and its listeners survive the DOM swap via transition:persist.
        if (window.__musicPlayerInitialized) {
            // If autoplay is enabled and the audio element is paused (e.g. user
            // navigated to the home page from a page without music), start playback.
            const root = document.getElementById('music-player-root');
            if (root && root.dataset.autoplay === 'true' && shouldAutoplayInSession()) {
                const audio = document.getElementById('music-player-audio');
                if (audio && audio.src && audio.paused && !audio.ended) {
                    audio.play().catch(() => {});
                }
            }
            return;
        }
        window.__musicPlayerInitialized = true;

        const root = document.getElementById('music-player-root');
        if (!root) return;

        const tracks = JSON.parse(root.dataset.tracks || '[]');
        if (!tracks.length) return;

        const autoplay = root.dataset.autoplay === 'true';

        const audio = document.getElementById('music-player-audio');
        const toggleBtn = document.getElementById('music-player-toggle');
        const playBtn = document.getElementById('music-player-play');
        const prevBtn = document.getElementById('music-player-prev');
        const nextBtn = document.getElementById('music-player-next');
        const volumeBtn = document.getElementById('music-player-volume-btn');
        const titleEl = document.getElementById('music-player-title');
        const seekSlider = document.getElementById('music-player-seek');
        const currentTimeEl = document.getElementById('music-player-current');
        const durationEl = document.getElementById('music-player-duration');
        const volumeSlider = document.getElementById('music-player-volume');
        const iconPlay = playBtn?.querySelector('.icon-play');
        const iconPause = playBtn?.querySelector('.icon-pause');
        const iconVolume = volumeBtn?.querySelector('.icon-volume');
        const iconMute = volumeBtn?.querySelector('.icon-mute');

        const STORAGE_KEY = 'music-player-state';
        const AUTOPLAY_PREFERENCE_KEY = 'music-player-autoplay-preference';

        let currentIndex = 0;
        let isPlaying = false;
        let volume = 0.7;
        let preMuteVolume = 0.7;

        function formatTime(seconds) {
            if (!isFinite(seconds) || seconds < 0) return '0:00';
            const m = Math.floor(seconds / 60);
            const s = Math.floor(seconds % 60);
            return `${m}:${s.toString().padStart(2, '0')}`;
        }

        function saveState() {
            const state = {
                currentIndex,
                currentTime: audio.currentTime,
                isPlaying: !audio.paused,
                volume,
                timestamp: Date.now(),
            };
            try {
                sessionStorage.setItem(STORAGE_KEY, JSON.stringify(state));
            } catch (_) {}
        }

        function loadState() {
            try {
                const raw = sessionStorage.getItem(STORAGE_KEY);
                if (!raw) return null;
                const state = JSON.parse(raw);
                // Only restore if saved within the last 10 seconds (same session)
                if (Date.now() - state.timestamp > 10000) {
                    sessionStorage.removeItem(STORAGE_KEY);
                    return null;
                }
                return state;
            } catch (_) {
                return null;
            }
        }

        function setAutoplayPreference(enabled) {
            try {
                if (enabled) {
                    sessionStorage.setItem(AUTOPLAY_PREFERENCE_KEY, 'enabled');
                } else {
                    sessionStorage.setItem(AUTOPLAY_PREFERENCE_KEY, 'disabled');
                }
            } catch (_) {}
        }

        function shouldAutoplayInSession() {
            try {
                return sessionStorage.getItem(AUTOPLAY_PREFERENCE_KEY) !== 'disabled';
            } catch (_) {
                return true;
            }
        }

        function updatePlayIcon() {
            if (!iconPlay || !iconPause) return;
            if (isPlaying) {
                iconPlay.style.display = 'none';
                iconPause.style.display = '';
            } else {
                iconPlay.style.display = '';
                iconPause.style.display = 'none';
            }
        }

        function updateVolumeIcon() {
            if (!iconVolume || !iconMute) return;
            if (volume === 0) {
                iconVolume.style.display = 'none';
                iconMute.style.display = '';
            } else {
                iconVolume.style.display = '';
                iconMute.style.display = 'none';
            }
            if (volumeSlider) volumeSlider.value = String(volume * 100);
        }

        function loadTrack(index) {
            currentIndex = ((index % tracks.length) + tracks.length) % tracks.length;
            const track = tracks[currentIndex];
            audio.src = track.src;
            titleEl.textContent = track.title;
            audio.load();
            seekSlider.value = '0';
            currentTimeEl.textContent = '0:00';
            durationEl.textContent = '0:00';
        }

        function play(updateAutoplayPreference = false) {
            audio.play().then(() => {
                isPlaying = true;
                if (updateAutoplayPreference) {
                    setAutoplayPreference(true);
                }
                updatePlayIcon();
                saveState();
            }).catch(() => {});
        }

        function pause(updateAutoplayPreference = false) {
            audio.pause();
            isPlaying = false;
            if (updateAutoplayPreference) {
                setAutoplayPreference(false);
            }
            updatePlayIcon();
            saveState();
        }

        function togglePlay() {
            if (isPlaying) {
                pause(true);
            } else {
                play(true);
            }
        }

        function next() {
            loadTrack(currentIndex + 1);
            if (isPlaying) play();
        }

        function prev() {
            if (audio.currentTime > 3) {
                audio.currentTime = 0;
                saveState();
                return;
            }
            loadTrack(currentIndex - 1);
            if (isPlaying) play();
        }

        // Expand/collapse
        toggleBtn?.addEventListener('click', () => {
            root.classList.add('music-player--expanded');
        });

        document.addEventListener('click', (e) => {
            if (root.classList.contains('music-player--expanded') && !root.contains(e.target)) {
                root.classList.remove('music-player--expanded');
            }
        });

        // Play/pause
        playBtn?.addEventListener('click', togglePlay);
        audio.addEventListener('play', () => {
            isPlaying = true;
            updatePlayIcon();
        });
        audio.addEventListener('pause', () => {
            isPlaying = false;
            updatePlayIcon();
        });

        // Previous/next
        prevBtn?.addEventListener('click', prev);
        nextBtn?.addEventListener('click', next);

        // Track ended — cycle to next track in playlist
        audio.addEventListener('ended', () => {
            next();
            if (!isPlaying) play();
        });

        // Progress / seek
        audio.addEventListener('timeupdate', () => {
            if (seekSlider && !seekSlider.matches(':active')) {
                const pct = audio.duration ? (audio.currentTime / audio.duration) * 100 : 0;
                seekSlider.value = String(pct);
            }
            currentTimeEl.textContent = formatTime(audio.currentTime);
        });

        audio.addEventListener('loadedmetadata', () => {
            durationEl.textContent = formatTime(audio.duration);
        });

        seekSlider?.addEventListener('input', () => {
            const time = (Number(seekSlider.value) / 100) * audio.duration;
            currentTimeEl.textContent = formatTime(time);
        });

        seekSlider?.addEventListener('change', () => {
            const time = (Number(seekSlider.value) / 100) * audio.duration;
            audio.currentTime = time;
            saveState();
        });

        // Volume
        volumeSlider?.addEventListener('input', () => {
            volume = Number(volumeSlider.value) / 100;
            audio.volume = volume;
            updateVolumeIcon();
            saveState();
        });

        volumeBtn?.addEventListener('click', () => {
            if (volume > 0) {
                preMuteVolume = volume;
                volume = 0;
            } else {
                volume = preMuteVolume || 0.7;
            }
            audio.volume = volume;
            updateVolumeIcon();
            if (volumeSlider) volumeSlider.value = String(volume * 100);
            saveState();
        });

        // State persistence on page unload
        window.addEventListener('beforeunload', () => {
            saveState();
        });

        // Periodic state save
        setInterval(() => {
            if (isPlaying) saveState();
        }, 5000);

        // --- Initialize audio source ---
        const savedState = loadState();

        if (savedState && savedState.currentIndex < tracks.length) {
            currentIndex = savedState.currentIndex;
            volume = savedState.volume ?? 0.7;
            audio.volume = volume;
            updateVolumeIcon();
            if (volumeSlider) volumeSlider.value = String(volume * 100);

            const track = tracks[currentIndex];
            audio.src = track.src;
            titleEl.textContent = track.title;

            const restorePosition = () => {
                if (savedState.currentTime > 0) {
                    audio.currentTime = savedState.currentTime;
                }
                if (savedState.isPlaying) {
                    play();
                }
                audio.removeEventListener('loadedmetadata', restorePosition);
            };
            audio.addEventListener('loadedmetadata', restorePosition);
            audio.load();
        } else {
            volume = 0.7;
            audio.volume = volume;
            updateVolumeIcon();
            if (volumeSlider) volumeSlider.value = '70';
            loadTrack(0);
        }

        // Auto-play on first visit if configured
        if (autoplay && !isPlaying && shouldAutoplayInSession()) {
            play();
        }
    })();
</script>
